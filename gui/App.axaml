<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenFusionCAD.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <!-- divdialog.css .button / .pri-btn / .sec-btn -->
    <Style Selector="Button.dlg">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="40,7" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pri">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#00A5E1" />
      <Setter Property="BorderBrush" Value="#00A5E1" />
    </Style>
    <Style Selector="Button.pri:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#42B6DF" />
      <Setter Property="BorderBrush" Value="#42B6DF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.pri:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#007FBE" />
      <Setter Property="BorderBrush" Value="#007FBE" />
    </Style>
    <Style Selector="Button.pri:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#80D4EF" />
      <Setter Property="BorderBrush" Value="#80D4EF" />
    </Style>
    <Style Selector="Button.sec">
      <Setter Property="Foreground" Value="#6E6E6E" />
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="BorderBrush" Value="#A2A2A2" />
    </Style>
    <Style Selector="Button.sec:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C9C9C9" />
      <Setter Property="Foreground" Value="#6E6E6E" />
    </Style>
    <Style Selector="Button.sec:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E8E8E8" />
      <Setter Property="BorderBrush" Value="#A1A1A1" />
    </Style>
    <Style Selector="Button.sec:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#FDFDFD" />
      <Setter Property="BorderBrush" Value="#D1D1D1" />
      <Setter Property="Foreground" Value="#B7B7B7" />
    </Style>
    <!-- main.css .uninstall-survey button / .precheck-dialog button -->
    <Style Selector="Button.gray">
      <Setter Property="Width" Value="180" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="2.4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Arial, Liberation Sans, sans-serif" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#898989" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.gray:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#9A9A9A" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- jQuery UI smoothness 버튼 (프록시 로그인 대화상자) -->
    <Style Selector="Button.jq">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#E6E6E6" />
      <Setter Property="BorderBrush" Value="#D3D3D3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#555555" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fusion Client Downloader (Linux) – 원본 NuJSBridge/HTML UI 를 Avalonia 로 재구현 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FusionClientDownloader</AssemblyName>
    <RootNamespace>OpenFusionCAD</RootNamespace>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <!-- 원본 divdialog.css 의 Open Sans 글꼴 (scripts/extract-assets.sh 로 추출) -->
    <AvaloniaResource Include="../resources/html/res/OpenSans-Regular.ttf" Link="Assets/Fonts/OpenSans-Regular.ttf" />
  </ItemGroup>
</Project>

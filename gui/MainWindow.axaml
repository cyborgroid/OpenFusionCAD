<!--
  원본 resources/html/index.html + main.css + divdialog.css 의 1:1 재현
  - 창: 860×500 고정 (.productlogo)
  - 배경: res/Deploy/<appid>/0..6.png, 진행률에 따라 1200ms 교차 페이드 (#backbuff)
  - 진행 영역: top 400px, 설명(굵게, 흰색 글로우) / 진행바(폭 30%, 높이 22, 불투명도 0.7) / 퍼센트 라벨
  - 대화상자: 오류(.hide-error-msg), 질의(.hide-query-msg), 사전 점검(#precheck-dialog),
    설치제거 설문(.uninstall-survey), 프록시 로그인(jQuery UI dialog)
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenFusionCAD.MainWindow"
        Title="Fusion Client Downloader"
        Width="860" Height="500" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="White">
  <Canvas x:Name="Root" Width="860" Height="500" ClipToBounds="True">

    <!-- .productlogo 배경 + #backbuff 백버퍼 -->
    <Image x:Name="Bg" Width="860" Height="500" Stretch="None" />
    <Image x:Name="BackBuff" Width="860" Height="500" Stretch="None" Opacity="0" IsVisible="False" />

    <!-- .pbarcontainer (top: 400px) -->
    <StackPanel x:Name="PbarContainer" Canvas.Top="400" Width="860">
      <TextBlock x:Name="ProgressDescription" Text=" " HorizontalAlignment="Center" TextAlignment="Center"
                 FontFamily="Tahoma, Verdana, DejaVu Sans, sans-serif" FontWeight="Bold" FontSize="16"
                 Foreground="#4D4D4D" TextWrapping="Wrap" MaxWidth="820">
        <TextBlock.Effect>
          <DropShadowEffect Color="White" BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="1" />
        </TextBlock.Effect>
      </TextBlock>
      <!-- .progressbar: width 30%, margin 5px auto / .ui-progressbar: height 22, opacity .7 -->
      <Panel Width="258" Height="22" Margin="0,5" HorizontalAlignment="Center">
        <Border x:Name="BarTrack" Background="White" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                Opacity="0.7" ClipToBounds="True">
          <Panel>
            <Border x:Name="BarValue" HorizontalAlignment="Left" Width="0" Background="#CCCCCC"
                    BorderBrush="#AAAAAA" BorderThickness="0,0,1,0" CornerRadius="3,0,0,3" />
            <!-- value:false (불확정) 애니메이션 -->
            <Border x:Name="BarIndeterminate" Width="80" HorizontalAlignment="Left" CornerRadius="3" IsVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#00CCCCCC" Offset="0" />
                  <GradientStop Color="#FFCCCCCC" Offset="0.5" />
                  <GradientStop Color="#00CCCCCC" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Panel>
        </Border>
        <!-- .progressbarlabel (top: -27px → 바 위에 겹침) -->
        <TextBlock x:Name="ProgressLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Tahoma, Verdana, DejaVu Sans, sans-serif" FontWeight="Bold" FontSize="13"
                   Foreground="#4D4D4D" />
      </Panel>
    </StackPanel>

    <!-- 설치제거 설문: .uninstall-survey (top 40, left 60, bottom 40, right 60, padding 15) -->
    <Border x:Name="SurveyPanel" IsVisible="False" Canvas.Left="60" Canvas.Top="40" Width="740" Height="420"
            Background="Black" Opacity="0.9" Padding="15">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
        <TextBlock x:Name="SurveyTitle" Foreground="White" FontSize="22" FontWeight="SemiBold"
                   FontFamily="Arial, Liberation Sans, sans-serif" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <Button x:Name="SurveyContinue" Classes="gray" HorizontalAlignment="Center" />
        <Button x:Name="SurveyCancel" Classes="gray" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 사전 점검: #precheck-dialog (top 140, left 50, bottom 150, right 50, padding 15) -->
    <Border x:Name="PrecheckPanel" IsVisible="False" Canvas.Left="50" Canvas.Top="140" Width="760" Height="210"
            Background="Black" Padding="15">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="RetestButton" Classes="gray" />
          <Button x:Name="CancelButton" Classes="gray" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
          <!-- glyphicon-remove-circle, 30px red -->
          <Panel Width="30" Height="30">
            <Ellipse Stroke="Red" StrokeThickness="2.5" />
            <Path Stroke="Red" StrokeThickness="2.5" Data="M 10,10 L 20,20 M 20,10 L 10,20" />
          </Panel>
          <TextBlock x:Name="PrecheckParagraph" Foreground="White" FontSize="12" Padding="10,10,0,0"
                     FontFamily="Arial, Liberation Sans, sans-serif" TextWrapping="Wrap" MaxWidth="680" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PrecheckRows" Spacing="15" Margin="0,15,0,0" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- .body-mask: 대화상자 뒤 입력 차단 (opacity 0) -->
    <Border x:Name="BodyMask" IsVisible="False" Width="860" Height="500" Background="#01000000" />

    <!-- 오류 대화상자: .dlg-common.hide-error-msg (top 2.5%, left 20%, width 500) -->
    <Border x:Name="ErrorDialog" IsVisible="False" Canvas.Left="172" Canvas.Top="12.5" Width="500"
            MinHeight="292" MaxHeight="471" Background="White" BorderBrush="#EFEFEF" BorderThickness="1"
            CornerRadius="3" BoxShadow="0 2 5 0 #000000">
      <DockPanel>
        <Border x:Name="ErrorTitlebar" DockPanel.Dock="Top" Height="78" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1"
                Background="Transparent" Cursor="SizeAll">
          <DockPanel>
            <Button x:Name="ErrorClose" DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="0,0,32,0"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
              <Image x:Name="ErrorCloseImg" Width="18" Height="18" />
            </Button>
            <TextBlock x:Name="ErrorTitle" Margin="34,0,0,0" Width="382" FontSize="22" FontWeight="Light"
                       Foreground="#6B6B6B" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <Border x:Name="ErrorBottom" DockPanel.Dock="Bottom" Height="118" BorderBrush="#D8D8D8" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,34,0" Spacing="8">
            <Button x:Name="BtnDir" Classes="dlg sec" />
            <Button x:Name="BtnOK" Classes="dlg pri" />
          </StackPanel>
        </Border>
        <ScrollViewer MaxHeight="275" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="34,113,20,299" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <TextBlock x:Name="Col11" Grid.Column="1" Grid.Row="0" TextAlignment="Right" Margin="0,34,0,0"
                       FontSize="13" Foreground="#111111" TextWrapping="Wrap" />
            <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,34,0,0" Spacing="10">
              <SelectableTextBlock x:Name="Col12" FontSize="13" LineHeight="23" Foreground="#767676" TextWrapping="Wrap" />
              <SelectableTextBlock x:Name="Col12Detail" FontSize="13" LineHeight="23" Foreground="#B1B1B1" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="Col21" Grid.Column="1" Grid.Row="1" TextAlignment="Right" Margin="0,34,0,0"
                       FontSize="13" Foreground="#111111" TextWrapping="Wrap" />
            <SelectableTextBlock x:Name="Col22" Grid.Column="3" Grid.Row="1" Margin="0,34,0,0" FontSize="13" LineHeight="23"
                                 Foreground="#767676" TextWrapping="Wrap" />
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 질의 대화상자: .dlg-common.hide-query-msg (top 13%, left 20%, width 500) -->
    <Border x:Name="QueryDialog" IsVisible="False" Canvas.Left="172" Canvas.Top="65" Width="500"
            MinHeight="243" MaxHeight="330" Background="White" BorderBrush="#EFEFEF" BorderThickness="1"
            CornerRadius="3" BoxShadow="0 2 5 0 #000000">
      <DockPanel>
        <Border x:Name="QueryTitlebar" DockPanel.Dock="Top" Height="78" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1"
                Background="Transparent" Cursor="SizeAll">
          <DockPanel>
            <Button x:Name="QueryClose" DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="0,0,32,0"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
              <Image x:Name="QueryCloseImg" Width="18" Height="18" />
            </Button>
            <TextBlock x:Name="QueryTitle" Margin="34,0,0,0" Width="382" FontSize="22" FontWeight="Light"
                       Foreground="#6B6B6B" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="118">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,34,0" Spacing="8">
            <Button x:Name="BtnNo" Classes="dlg sec" />
            <Button x:Name="BtnYes" Classes="dlg pri" />
          </StackPanel>
        </Border>
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="34,34,34,0">
          <SelectableTextBlock x:Name="QueryBody" FontSize="13" LineHeight="23" Foreground="#767676" TextWrapping="Wrap" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 프록시 로그인: jQuery UI dialog (smoothness, modal, noclose) -->
    <Border x:Name="ProxyDialog" IsVisible="False" Canvas.Left="280" Canvas.Top="150" Width="300"
            Background="White" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4" Padding="3">
      <StackPanel>
        <Border Background="#CCCCCC" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4" Padding="7,4">
          <TextBlock x:Name="ProxyTitle" FontWeight="Bold" FontSize="11" Foreground="#222222" />
        </Border>
        <StackPanel Margin="10,8" Spacing="6">
          <TextBlock x:Name="ProxyMessage" FontSize="11" TextWrapping="Wrap" Foreground="#222222" />
          <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Text="Username: " FontSize="11" VerticalAlignment="Center" />
            <TextBox x:Name="ProxyUser" Grid.Column="1" FontSize="11" />
            <TextBlock Grid.Row="1" Text="Password:" FontSize="11" VerticalAlignment="Center" />
            <TextBox x:Name="ProxyPass" Grid.Row="1" Grid.Column="1" PasswordChar="●" FontSize="11" />
          </Grid>
        </StackPanel>
        <Border BorderBrush="#AAAAAA" BorderThickness="0,1,0,0" Padding="8,6">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button x:Name="ProxyOk" Classes="jq" Content="Ok" />
            <Button x:Name="ProxyCancel" Classes="jq" Content="Cancel" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
